<Window x:Class="LoafEar.Overlay.SubtitleBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LoafEar-Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Opacity="0"
        Width="420"
        Height="40">

    <!--
        悬浮模式下窗口会比字幕条本身高出一行：上面那条放锁按钮（"桌面歌词"那种玩法）。
        吸附在任务栏时这一行 Collapsed，窗口高度仍然只有字幕条那么高。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 锁按钮摆在字幕条正上方中间；本身不带底板，只有图标浮在桌面上 -->
        <Grid x:Name="LockHost"
              Grid.Row="0"
              HorizontalAlignment="Center"
              VerticalAlignment="Bottom"
              Margin="0,0,0,2"
              Background="Transparent"
              Visibility="Collapsed">
            <Button x:Name="LockButton"
                    Width="24" Height="20"
                    Cursor="Hand"
                    Focusable="False"
                    Click="OnLockClick">
                <!-- 没有底板，浅色桌面上白色图标会糊掉，补一圈很淡的投影当描边 -->
                <Button.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="9" ShadowDepth="0" Opacity="0.55" />
                </Button.Effect>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- 不要背景板：只在悬停时把图标提亮一点，避免看不出可点 -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <Border x:Name="Panel"
                Grid.Row="1"
                Padding="10,0,10,0"
                CornerRadius="5"
                BorderThickness="0"
                MouseLeftButtonDown="OnPanelMouseDown">
            <Grid x:Name="ContentGrid">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="MainHost" Grid.Column="0" VerticalAlignment="Center">
                        <!--
                            句子比字幕条宽时按词边界分页：MainClip 的宽度会收缩到「这一页刚好到最后一个词」，
                            再配合位移把这一页推到左边缘，所以既不会切掉半个单词，也不会留下多余空白。
                            这里必须用 Canvas 而不是 Grid：Grid 会把列宽当排版约束传给 TextBlock，
                            超出的字根本不会被画出来；Canvas 用无限宽量孩子，文本才按自然宽度排版完整。
                        -->
                        <Canvas x:Name="MainClip" ClipToBounds="True" HorizontalAlignment="Left">
                            <TextBlock x:Name="MainText"
                                       Canvas.Left="0"
                                       Canvas.Top="1"
                                       FontSize="13"
                                       FontFamily="Segoe UI, Microsoft YaHei UI"
                                       TextWrapping="NoWrap"
                                       TextTrimming="None">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform x:Name="MainShift" X="0" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Canvas>
                        <TextBlock x:Name="SubText"
                                   FontSize="11"
                                   FontFamily="Segoe UI, Microsoft YaHei UI"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,1,0,0" />
                    </StackPanel>

                    <TextBlock x:Name="TimeText"
                               Grid.Column="1"
                               FontSize="11"
                               FontFamily="Segoe UI"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
